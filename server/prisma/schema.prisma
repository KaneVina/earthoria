generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─ USER ─
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String
  firstName String?
  lastName  String?
  dob       DateTime?
  gender    Gender?
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)

  // Lý do vô hiệu hóa tài khoản (bắt buộc nhập khi khóa từ trang Admin)
  lockReason String?
  lockedAt   DateTime?
  lockedBy   String?

  // Mã định danh người dùng
  userCode  String?  @unique

  resetOtpHash      String?
  resetOtpExpires   DateTime?
  resetOtpAttempts  Int       @default(0)

  // ─ Parental PIN (bảo vệ trang Bảng điều khiển phụ huynh) ─
  parentPinHash          String?
  parentPinAttempts      Int       @default(0)
  parentPinLockedUntil   DateTime?
  parentPinResetOtpHash    String?
  parentPinResetOtpExpires DateTime?
  parentPinResetOtpAttempts Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  wishlist      Wishlist[]
  refreshTokens RefreshToken[]
  inventoryImports InventoryImport[]

  children      ChildProfile[]
  childAuditLogs ChildAuditLog[]

  // ─ Ticket liên hệ (Contact) ─
  tickets         Ticket[]      @relation("TicketRequester")
  assignedTickets Ticket[]      @relation("TicketAssignee")
  ticketReplies   TicketReply[]
}

// Bảng đếm số thứ tự theo ngày để sinh userCode
model UserCodeSeq {
  date  String @id   // format: "YYYYMMDD"
  seq   Int    @default(0)
}

enum Role {
  CUSTOMER
   DEALER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─ PENDING USER (chờ xác thực OTP khi đăng ký) ─
model PendingUser {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  phone       String?
  otpHash     String
  otpExpires  DateTime
  otpAttempts Int      @default(0)
  createdAt   DateTime @default(now())
}

// ─ ADDRESS ─
model Address {
  id        String  @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  province  String
  district  String
  ward      String
  street    String
  isDefault Boolean @default(false)
  lat       Float?
  lng       Float?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model ProductCodeSeq {
  date String @id
  seq  Int    @default(0)
}

model InventoryImport {
  id        String   @id @default(uuid())
  code      String   @unique
  createdBy String
  createdAt DateTime @default(now())

  creator User                   @relation(fields: [createdBy], references: [id])
  items    InventoryImportItem[]

  @@index([createdBy])
}

model InventoryImportItem {
  id          String  @id @default(uuid())
  importId    String
  variantId   String
  title       String
  productCode String?
  unit        String
  oldQty      Int
  qtyDocument Int?
  qtyActual   Int
  unitPrice   Float

  import  InventoryImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  variant BookVariant     @relation(fields: [variantId], references: [id])

  @@index([importId])
  @@index([variantId])
}

// ─ CATEGORY ─
model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)

  books Book[]
}

// ─ BOOK ─
model Book {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String?
  ageMin        Int?
  ageMax        Int?
  language      String   @default("VI")
  pages         Int?
  publisher     String?
  publishYear   Int?
  dimensions    String?  // chuỗi tự do, vd "21 x 28 x 1.2 cm"
  weightGrams   Int?
  coverType     String?  // vd "Cứng, chống nước"
  paperType     String?  // vd "FSC Certified 150gsm"
  coverImage    String?
  images        String[]
  arModelUrl    String?
  arPreviewUrls String[]
  hasAR         Boolean  @default(true)
  hasAI         Boolean  @default(true)
  has3DAudio    Boolean  @default(false)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  categoryId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category     @relation(fields: [categoryId], references: [id])
  variants BookVariant[]
  reviews  Review[]
  wishlist Wishlist[]
  arCodes  ArCode[]
  authors  BookAuthor[]
  tags     BookTag[]

  childAccess     ChildBookAccess[]
  childActivities ChildActivityLog[]

  @@index([categoryId])
  @@index([language])
  @@index([isActive])
}

enum BookFormat {
  PHYSICAL
  DIGITAL
}

// ─ BOOK VARIANT ─
model BookVariant {
  id               String     @id @default(uuid())
  bookId           String
  format           BookFormat
  productCode      String?    @unique
  unit             String     @default("Cuốn")
  price            Float
  salePrice        Float?
  dealerPrice      Float?
  stock            Int        @default(0)
  sold             Int        @default(0)
  isUnlimitedStock Boolean    @default(false)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  book                 Book                   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cartItems            CartItem[]
  orderItems           OrderItem[]
  inventoryImportItems InventoryImportItem[]

  // 1 Book chỉ có 1 variant PHYSICAL và 1 variant DIGITAL — không cho tạo trùng format
  @@unique([bookId, format])
  @@index([bookId])
  @@index([productCode])
}

// ─ TAG ─
model Tag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books BookTag[]
}

model BookTag {
  bookId String
  tagId  String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
}

// ─ AUTHOR ─
model Author {
  id    String       @id @default(uuid())
  name  String       @unique
  books BookAuthor[]
}

model BookAuthor {
  bookId   String
  authorId String
  order    Int    @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
}

// ─ AR CODE ─
enum ArAccessType {
  CUSTOMER_ONLY
  PUBLIC
}

model ArCode {
  id         String       @id @default(uuid())
  code       String       @unique
  label      String
  modelUrl   String
  posterUrl  String?
  bookId     String
  isActive   Boolean      @default(true)
  accessType ArAccessType @default(CUSTOMER_ONLY)
  scanCount  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

// ─ CART ─
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant BookVariant @relation(fields: [variantId], references: [id])

  // Chặn cứng ở tầng DB: 1 giỏ hàng không thể có 2 dòng cùng variant
  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─ ORDER ─
model Order {
  id              String        @id @default(uuid())
  userId          String
  addressId       String
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Float
  shippingFee     Float         @default(0)
  discount        Float         @default(0)
  total           Float
  note            String?
  stripePaymentId String?
  couponCode      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant BookVariant @relation(fields: [variantId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  STRIPE
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ─ REVIEW ─
model Review {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  rating    Int
  title     String?
  content   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// ─ WISHLIST ─
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// ─ COUPON ─
model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique
  type        CouponType
  value       Float
  minOrder    Float      @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ─ REFRESH TOKEN ─
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  remember   Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   // id của token thay thế nó khi rotate
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model ChildProfile {
  id        String   @id @default(uuid())
  parentId  String
  name      String
  dob       DateTime
  avatarEmoji String @default("🦊")
  avatarColor String @default("#4a9e3f")
  isActive  Boolean  @default(true) // xoá mềm

  kidLinkToken String? @unique

  // ─ Khoá AR tức thời ─
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?

  // ─ Giới hạn giờ & quy tắc bảo vệ mắt (đồng bộ với DEFAULT_SETTINGS ở FE) ─
  dailyLimitMinutes     Int     @default(60)
  ruleEnabled           Boolean @default(true)
  ruleIntervalMinutes   Int     @default(20)
  ruleRestSeconds       Int     @default(20)
  allowWindowEnabled    Boolean @default(true)
  allowStart            String  @default("07:00") // "HH:mm"
  allowEnd              String  @default("20:30")
  mandatoryBreakEnabled Boolean @default(true)
  breakAfterMinutes     Int     @default(45)
  breakDurationMinutes  Int     @default(10)
  tipsEnabled           Boolean @default(true)
  tipsFrequency         String  @default("rest") // 'open' | 'interval' | 'rest'
  notifyPush            Boolean @default(true)
  notifyEmail           Boolean @default(false)
  notifyOnLimitExceeded Boolean @default(true)
  notifyOnSkippedRest   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  bookAccess  ChildBookAccess[]
  activities  ChildActivityLog[]
  auditLogs   ChildAuditLog[]

  @@index([parentId])
}

model ChildBookAccess {
  id       String  @id @default(uuid())
  childId  String
  bookId   String
  visible  Boolean @default(true)

  updatedAt DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  book  Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([childId, bookId])
  @@index([childId])
  @@index([bookId])
}

// Nhật ký phiên đọc/xem AR của trẻ — nguồn dữ liệu thật cho biểu đồ
model ChildActivityLog {
  id         String   @id @default(uuid())
  childId    String
  bookId     String?
  minutes    Int
  occurredOn DateTime @default(now()) // dùng để gom nhóm theo ngày (UTC date)
  createdAt  DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  book  Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([childId, occurredOn])
}

enum ChildAuditType {
  CHILD_CREATED
  CHILD_UPDATED
  CHILD_ARCHIVED
  LOCK
  UNLOCK
  SETTINGS_UPDATE
  BOOK_VISIBILITY
  PARENT_PIN_SET
  PARENT_PIN_CHANGED
  PARENT_PIN_RESET
  CHILD_DELETED
  KID_LINK_REGENERATED
}

// Nhật ký hành động của phụ huynh
model ChildAuditLog {
  id        String         @id @default(uuid())
  childId   String?
  parentId  String
  type      ChildAuditType
  message   String
  metadata  Json?
  createdAt DateTime       @default(now())

  child  ChildProfile? @relation(fields: [childId], references: [id], onDelete: SetNull)
  parent User          @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([parentId, createdAt])
}

// ─ TICKET (form Liên hệ /contact) ─
enum TicketStatus {
  NEW         // Mới gửi, chưa ai xử lý
  IN_PROGRESS // Staff/Admin đang xử lý
  RESOLVED    // Đã xử lý xong
  CLOSED      // Đã đóng (không cần theo dõi tiếp)
}

enum TicketSubject {
  PRODUCT_ADVICE     // Tư vấn sản phẩm
  BUSINESS           // Hợp tác kinh doanh
  TECHNICAL_SUPPORT  // Hỗ trợ kỹ thuật
  FEEDBACK           // Phản hồi / Góp ý
  OTHER              // Khác
}

model Ticket {
  id             String        @id @default(uuid())
  code           String        @unique // vd: ETK-260809k5L
  userId         String?       // gắn nếu người gửi đang đăng nhập, cho phép khách vãng lai gửi (null)
  name           String
  email          String
  phone          String?
  company        String?
  subject        TicketSubject
  extraFields    Json?         // field phụ tuỳ chủ đề (product, orderId, rating, ...)
  message        String
  contactMethods String[]      // phone | zalo | email | facebook
  status         TicketStatus  @default(NEW)
  assignedToId   String?       // staff/admin đang phụ trách vé này
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User?         @relation("TicketRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  replies    TicketReply[]

  @@index([status])
  @@index([userId])
  @@index([assignedToId])
  @@index([email])
  @@index([createdAt])
}

// Lịch sử phản hồi của staff/admin cho 1 ticket — mỗi bản ghi tương ứng 1 email tự động gửi cho khách
model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  staffId   String
  message   String
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffId], references: [id])

  @@index([ticketId])
}