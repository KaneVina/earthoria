generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─ USER ─
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String
  firstName String?
  lastName  String?
  dob       DateTime?
  gender    Gender?
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)

  // Mã định danh người dùng: ETR-Role-MMDDYY-SEQ-rand (vd: ETRC062926001ak)
  userCode  String?  @unique

  resetOtpHash      String?
  resetOtpExpires   DateTime?
  resetOtpAttempts  Int       @default(0)

  // ─ Parental PIN (bảo vệ trang Bảng điều khiển phụ huynh) ─
  parentPinHash          String?
  parentPinAttempts      Int       @default(0)
  parentPinLockedUntil   DateTime?
  parentPinResetOtpHash    String?
  parentPinResetOtpExpires DateTime?
  parentPinResetOtpAttempts Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  wishlist      Wishlist[]
  refreshTokens RefreshToken[]
  inventoryImports InventoryImport[]

  children      ChildProfile[]
  childAuditLogs ChildAuditLog[]
}

// Bảng đếm số thứ tự theo ngày để sinh userCode
model UserCodeSeq {
  date  String @id   // format: "YYYYMMDD"
  seq   Int    @default(0)
}

enum Role {
  CUSTOMER
   DEALER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─ PENDING USER (chờ xác thực OTP khi đăng ký) ─
model PendingUser {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  phone       String?
  otpHash     String
  otpExpires  DateTime
  otpAttempts Int      @default(0)
  createdAt   DateTime @default(now())
}

// ─ ADDRESS ─
model Address {
  id        String  @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  province  String
  district  String
  ward      String
  street    String
  isDefault Boolean @default(false)
  lat       Float?
  lng       Float?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model ProductCodeSeq {
  date String @id
  seq  Int    @default(0)
}

model InventoryImport {
  id        String   @id @default(uuid())
  code      String   @unique
  createdBy String
  createdAt DateTime @default(now())

  creator User                   @relation(fields: [createdBy], references: [id])
  items    InventoryImportItem[]

  @@index([createdBy])
}

model InventoryImportItem {
  id          String  @id @default(uuid())
  importId    String
  variantId   String
  title       String
  productCode String?
  unit        String
  oldQty      Int
  qtyDocument Int?
  qtyActual   Int
  unitPrice   Float

  import  InventoryImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  variant BookVariant     @relation(fields: [variantId], references: [id])

  @@index([importId])
  @@index([variantId])
}

// ─ CATEGORY ─
model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)

  books Book[]
}

// ─ BOOK ─
model Book {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String?
  ageMin        Int?
  ageMax        Int?
  language      String   @default("VI")
  pages         Int?
  publisher     String?
  publishYear   Int?
  dimensions    String?  // chuỗi tự do, vd "21 x 28 x 1.2 cm"
  weightGrams   Int?
  coverType     String?  // vd "Cứng, chống nước"
  paperType     String?  // vd "FSC Certified 150gsm"
  coverImage    String?
  images        String[]
  arModelUrl    String?
  arPreviewUrls String[]
  hasAR         Boolean  @default(true)
  hasAI         Boolean  @default(true)
  has3DAudio    Boolean  @default(false)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  categoryId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category     @relation(fields: [categoryId], references: [id])
  variants BookVariant[]
  reviews  Review[]
  wishlist Wishlist[]
  arCodes  ArCode[]
  authors  BookAuthor[]
  tags     BookTag[]

  childAccess     ChildBookAccess[]
  childActivities ChildActivityLog[]

  @@index([categoryId])
  @@index([language])
  @@index([isActive])
}

enum BookFormat {
  PHYSICAL
  DIGITAL
}

// ─ BOOK VARIANT ─
model BookVariant {
  id               String     @id @default(uuid())
  bookId           String
  format           BookFormat
  productCode      String?    @unique
  unit             String     @default("Cuốn")
  price            Float
  salePrice        Float?
  dealerPrice      Float?
  stock            Int        @default(0)
  sold             Int        @default(0)
  isUnlimitedStock Boolean    @default(false)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  book                 Book                   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cartItems            CartItem[]
  orderItems           OrderItem[]
  inventoryImportItems InventoryImportItem[]

  // 1 Book chỉ có 1 variant PHYSICAL và 1 variant DIGITAL — không cho tạo trùng format
  @@unique([bookId, format])
  @@index([bookId])
  @@index([productCode])
}

// ─ TAG ─
model Tag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books BookTag[]
}

model BookTag {
  bookId String
  tagId  String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
}

// ─ AUTHOR ─
// 1 sách có thể có nhiều tác giả, 1 tác giả có thể viết nhiều sách -> quan hệ n-n qua BookAuthor
model Author {
  id    String       @id @default(uuid())
  name  String       @unique
  books BookAuthor[]
}

// Bảng nối Book <-> Author, có `order` để giữ đúng thứ tự tác giả khi hiển thị
// (vd: "Tác giả chính, Đồng tác giả" thay vì bị xáo trộn)
model BookAuthor {
  bookId   String
  authorId String
  order    Int    @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
}

// ─ AR CODE ─
// Mỗi sách có thể có nhiều mã AR (vd: sách về động vật -> mã riêng cho
// con voi, con heo...). Mỗi mã gắn với 1 model 3D và được in thành 1 QR
// cố định trong sách giấy, nên `code` không bao giờ được đổi sau khi in.
//
// BẢO MẬT: `code` PHẢI là chuỗi ngẫu nhiên sinh bằng CSPRNG (crypto.randomBytes),
// KHÔNG được là số đếm tăng dần hay encode/decode được (vd hashids), vì đó
// chỉ là obfuscation hai chiều, không chống được việc đoán mã giữa các sách.
// `code` là chìa khóa tra cứu duy nhất — `slug` trong URL chỉ để hiển thị
// tên sách đẹp mắt, KHÔNG được dùng để xác thực hay tra cứu.
enum ArAccessType {
  CUSTOMER_ONLY
  PUBLIC
}

model ArCode {
  id         String       @id @default(uuid())
  code       String       @unique
  label      String
  modelUrl   String
  posterUrl  String?
  bookId     String
  isActive   Boolean      @default(true)
  accessType ArAccessType @default(CUSTOMER_ONLY)
  scanCount  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

// ─ CART ─
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant BookVariant @relation(fields: [variantId], references: [id])

  // Chặn cứng ở tầng DB: 1 giỏ hàng không thể có 2 dòng cùng variant
  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─ ORDER ─
model Order {
  id              String        @id @default(uuid())
  userId          String
  addressId       String
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Float
  shippingFee     Float         @default(0)
  discount        Float         @default(0)
  total           Float
  note            String?
  stripePaymentId String?
  couponCode      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant BookVariant @relation(fields: [variantId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  STRIPE
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ─ REVIEW ─
model Review {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  rating    Int
  title     String?
  content   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// ─ WISHLIST ─
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// ─ COUPON ─
model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique
  type        CouponType
  value       Float
  minOrder    Float      @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ─ REFRESH TOKEN ─
// Không lưu token gốc, chỉ lưu hash (SHA-256). Hỗ trợ rotation +
// reuse detection: khi 1 token đã revoke mà vẫn bị dùng lại => dấu
// hiệu bị đánh cắp => revoke toàn bộ các token cùng chain của user.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  remember   Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   // id của token thay thế nó khi rotate
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model ChildProfile {
  id        String   @id @default(uuid())
  parentId  String
  name      String
  dob       DateTime
  avatarEmoji String @default("🦊")
  avatarColor String @default("#4a9e3f")
  isActive  Boolean  @default(true) // xoá mềm — ẩn hồ sơ thay vì xoá vĩnh viễn

  // ─ Khoá AR tức thời ─
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?

  // ─ Giới hạn giờ & quy tắc bảo vệ mắt (đồng bộ với DEFAULT_SETTINGS ở FE) ─
  dailyLimitMinutes     Int     @default(60)
  ruleEnabled           Boolean @default(true)
  ruleIntervalMinutes   Int     @default(20)
  ruleRestSeconds       Int     @default(20)
  allowWindowEnabled    Boolean @default(true)
  allowStart            String  @default("07:00") // "HH:mm"
  allowEnd              String  @default("20:30")
  mandatoryBreakEnabled Boolean @default(true)
  breakAfterMinutes     Int     @default(45)
  breakDurationMinutes  Int     @default(10)
  tipsEnabled           Boolean @default(true)
  tipsFrequency         String  @default("rest") // 'open' | 'interval' | 'rest'
  notifyPush            Boolean @default(true)
  notifyEmail           Boolean @default(false)
  notifyOnLimitExceeded Boolean @default(true)
  notifyOnSkippedRest   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  bookAccess  ChildBookAccess[]
  activities  ChildActivityLog[]
  auditLogs   ChildAuditLog[]

  @@index([parentId])
}

// Bật/tắt hiển thị cho từng sách đã mua theo từng con. Chỉ những sách nằm
// trong đơn hàng đã thanh toán của phụ huynh mới có thể được bật hiển thị —
// việc này được kiểm tra ở tầng service, bảng này chỉ lưu lựa chọn bật/tắt.
// Không có dòng cho (childId, bookId) ⇒ mặc định là HIỂN THỊ (opt-out model),
// vì mặc định trẻ nên thấy toàn bộ sách cha mẹ đã mua cho tới khi cha mẹ ẩn đi.
model ChildBookAccess {
  id       String  @id @default(uuid())
  childId  String
  bookId   String
  visible  Boolean @default(true)

  updatedAt DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  book  Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([childId, bookId])
  @@index([childId])
  @@index([bookId])
}

// Nhật ký phiên đọc/xem AR của trẻ — nguồn dữ liệu thật cho biểu đồ
// "hôm nay", "7 ngày qua" và danh sách phiên gần đây trên dashboard.
model ChildActivityLog {
  id         String   @id @default(uuid())
  childId    String
  bookId     String?
  minutes    Int
  occurredOn DateTime @default(now()) // dùng để gom nhóm theo ngày (UTC date)
  createdAt  DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  book  Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([childId, occurredOn])
}

enum ChildAuditType {
  CHILD_CREATED
  CHILD_UPDATED
  CHILD_ARCHIVED
  LOCK
  UNLOCK
  SETTINGS_UPDATE
  BOOK_VISIBILITY
  PARENT_PIN_SET
  PARENT_PIN_CHANGED
  PARENT_PIN_RESET
}

// Nhật ký hành động của phụ huynh — mọi thao tác nhạy cảm (khoá/mở khoá,
// đổi giờ giấc, đổi PIN, ẩn/hiện sách...) đều được ghi lại kèm ai
// (parentId), làm gì (type), với con nào.
model ChildAuditLog {
  id        String         @id @default(uuid())
  childId   String?
  parentId  String
  type      ChildAuditType
  message   String
  metadata  Json?
  createdAt DateTime       @default(now())

  child  ChildProfile? @relation(fields: [childId], references: [id], onDelete: SetNull)
  parent User          @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([parentId, createdAt])
}